<mujoco model="go2 5-step 15cm stairs scene">
  <include file="go2.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="step_mat_1" rgba="0.45 0.55 0.62 1"/>
    <material name="step_mat_2" rgba="0.38 0.48 0.54 1"/>
    <material name="rail_mat" rgba="0.6 0.6 0.65 0.8"/>
  </asset>

  <worldbody>
    <light pos="2.5 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 5-Step Staircase: step_width=0.30m, step_height=0.15m, width=6.0m -->
    <!-- Step 1: x in [1.5, 1.8], height = 0.15m -->
    <geom name="step_1" type="box" size="0.15 3.0 0.075" pos="1.65 0 0.075" material="step_mat_1" friction="0.8 0.02 0.01"/>
    
    <!-- Step 2: x in [1.8, 2.1], height = 0.30m -->
    <geom name="step_2" type="box" size="0.15 3.0 0.15" pos="1.95 0 0.15" material="step_mat_2" friction="0.8 0.02 0.01"/>
    
    <!-- Step 3: x in [2.1, 2.4], height = 0.45m -->
    <geom name="step_3" type="box" size="0.15 3.0 0.225" pos="2.25 0 0.225" material="step_mat_1" friction="0.8 0.02 0.01"/>
    
    <!-- Step 4: x in [2.4, 2.7], height = 0.60m -->
    <geom name="step_4" type="box" size="0.15 3.0 0.30" pos="2.55 0 0.30" material="step_mat_2" friction="0.8 0.02 0.01"/>
    
    <!-- Step 5: x in [2.7, 3.0], height = 0.75m -->
    <geom name="step_5" type="box" size="0.15 3.0 0.375" pos="2.85 0 0.375" material="step_mat_1" friction="0.8 0.02 0.01"/>
    
    <!-- Top Platform: x in [3.0, 7.5], height = 0.75m, length = 4.5m -->
    <geom name="top_platform" type="box" size="2.25 3.0 0.375" pos="5.25 0 0.375" material="step_mat_2" friction="0.8 0.02 0.01"/>

    <!-- Left & Right Safety Rails to prevent walking off side -->
    <geom name="rail_left" type="box" size="3.0 0.05 0.5" pos="4.5 3.0 0.5" material="rail_mat"/>
    <geom name="rail_right" type="box" size="3.0 0.05 0.5" pos="4.5 -3.0 0.5" material="rail_mat"/>
  </worldbody>
</mujoco>
